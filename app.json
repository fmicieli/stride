{
  "expo": {
    "name": "Stride",
    "slug": "Stride",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Stride usa tu ubicación para rastrear tus entrenamientos y calcular distancia y pace.",
        "NSLocationAlwaysUsageDescription": "Stride usa tu ubicación para rastrear tus entrenamientos."
      },
      "bundleIdentifier": "com.anonymous.Stride"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "lang": "es",
      "name": "Stride",
      "shortName": "Stride"
    },
    "experiments": {
      "baseUrl": "/stride"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font"
    ]
  }
}
